# SwapThrift backend configuration
# Copy this file to .env and replace the placeholder values. NEVER commit real secrets.

# Server
PORT=5000
# Frontend origin(s) used for CORS, cookies and socket connections.
# Comma-separated list is supported, e.g. production URL + preview URL.
CLIENT_URL=http://localhost:5173
# Optional extra origins (useful for Vercel/Netlify preview deployments)
CORS_ORIGINS=
# Public origin used in uploaded image URLs (only needed for local upload fallback)
API_PUBLIC_URL=http://localhost:5000

# MongoDB Atlas connection string (do not share)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/swapthrift?retryWrites=true&w=majority

# Random secret used to sign JWTs
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# SMTP / email delivery (optional in development; emails are only logged when missing)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hello@example.com
SMTP_PASS=replace-with-smtp-password
# Optional sender address, defaults to "SwapThrift" <SMTP_USER>
# SMTP_FROM=SwapThrift <hello@example.com>

# Cloudinary (optional: without these values uploads are stored locally in backend/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe sandbox only. Never use a live key in this project.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Initial admin account, created on startup / by `npm run seed` when absent
ADMIN_EMAIL=
ADMIN_PASSWORD=
